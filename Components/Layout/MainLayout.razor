@inherits LayoutComponentBase

<div class="min-h-screen overflow-hidden">
    <Header />

    @Body

    <footer class="flex min-h-[100px] flex-col items-start justify-center gap-2 bg-ink px-[4vw] font-mono text-[9px] text-[#aaa79f] uppercase sm:flex-row sm:items-center sm:justify-between sm:gap-0">
        <span>BeyondCanvas © 2025</span>
        <span>Curated on Ethereum</span>
        <span>Brooklyn · Berlin · Everywhere</span>
    </footer>
</div>

<div id="blazor-error-ui" class="fixed inset-x-0 bottom-0 z-50 hidden bg-acid px-5 py-3 text-sm text-ink">
    An unhandled error has occurred.
    <a href="" class="reload font-semibold underline">Reload</a>
    <span class="dismiss float-right cursor-pointer">🗙</span>
</div>
