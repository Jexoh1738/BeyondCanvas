<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Builds Tailwind before every build, but only if the standalone CLI is in the project folder -->
  <Target Name="BuildTailwind" BeforeTargets="Build" Condition="Exists('tailwindcss.exe')">
    <Exec Command="tailwindcss.exe -i Styles/app.css -o wwwroot/app.css --minify" />
  </Target>

</Project>
